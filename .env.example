# Copy to .env and fill in. .env is gitignored.

# Models, as "<provider>:<model-id>". Pick any provider below; mix them per role.
#   groq:openai/gpt-oss-120b         GROQ_API_KEY            (also groq:openai/gpt-oss-20b, groq:qwen/qwen3.8-27b)
#   anthropic:claude-sonnet-5-5      ANTHROPIC_API_KEY       Claude (alias claude:); Console key, not a Pro login
#   google:gemini-2.5-flash          GOOGLE_API_KEY          Gemini via Google AI Studio (alias gemini:)
#   google-cloud:gemini-2.5-flash    GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION + credentials (Vertex AI)
#   openai:gpt-5.2                   OPENAI_API_KEY          OpenAI (openai-chat: for the Chat Completions API)
#   openrouter:<vendor>/<model>      OPENROUTER_API_KEY
#   ollama:qwen3:14b                 local; OLLAMA_BASE_URL optional (default http://localhost:11434/v1)
#   lmstudio:<model-id>              local; LMSTUDIO_BASE_URL optional (default http://localhost:1234/v1)
#   vllm:<model-id>                  local/self-hosted; VLLM_BASE_URL (default http://localhost:8000/v1)
#   compat:<name>:<model-id>         any OpenAI-compatible server; COMPAT_<NAME>_BASE_URL (+ COMPAT_<NAME>_API_KEY)
#   oxion:<model-id>                 OXION_API_KEY
# In Docker, local servers on the host are reached via host.docker.internal automatically.
# Not chat models (don't use): llama-prompt-guard, whisper, orpheus.
CHAT_MODEL=groq:openai/gpt-oss-20b      # chat: fast, answers can be asked again
JOB_MODEL=groq:openai/gpt-oss-120b      # capture/sync/lint/digest: strongest, output is saved
VERIFY_MODEL=groq:qwen/qwen3.8-27b      # fact-check: a different model from the writer
MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Optional: a different model per role (empty = MODEL; VERIFY_MODEL falls back to JOB_MODEL).
# Wiki jobs (capture, sync, lint, digest) write the permanent wiki: give them the strongest model.
# Chat can be faster/cheaper. A different fact-check model catches errors the writer would repeat.
# On Groq, rate limits are per model, so splitting roles also splits the token budget.
# CHAT_MODEL=groq:openai/gpt-oss-20b
# JOB_MODEL=groq:openai/gpt-oss-120b
# VERIFY_MODEL=groq:qwen/qwen3.8-27b

# Provider keys and endpoints (fill in the ones your models use):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                       # only for an OpenAI-hosted proxy/gateway, not for local models
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1   # Docker + bundled ollama service: http://ollama:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# COMPAT_LOCAL_BASE_URL=http://localhost:1337/v1   # e.g. Jan, LocalAI, llama.cpp; use as compat:local:<model>
# COMPAT_LOCAL_API_KEY=
# OXION_API_KEY=cc_...
# OXION_BASE_URL=https://www.oxionai.com/v1

# Neo4j with the PhosphoSIGNOR graph. NEO4J_PASSWORD is required by docker-compose (8+ chars).
# With Docker the app always talks to the bundled Neo4j (bolt://neo4j:7687); NEO4J_URI here is
# only for running the backend directly on your machine.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword
NEO4J_DATABASE=neo4j

# Login. On startup, if no admin exists, this account is created (or promoted and its
# password reset). Admins then add other users on the Users page. Users and sessions are
# stored in DATA_DIR/phosphochat.db (gitignored).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456A@
DATA_DIR=data
SESSION_DAYS=14
# Set true when the site is served over https, so the session cookie is only sent securely.
COOKIE_SECURE=false

# Where vaults live (relative to the repo root) and which one the UI opens first.
VAULTS_DIR=vaults
DEFAULT_VAULT=default

# Max characters of any single tool result sent back to the model (keeps Groq free-tier TPM in check).
TOOL_OUTPUT_CHARS=8000

# After capture/sync, fact-check the new pages against their sources and let the writer fix
# unsupported claims (about 1.5-2x the tokens of a capture). Off by default; set true to enable.
# The switch on the Capture screen overrides this per capture.
VERIFY_CAPTURES=false
VERIFY_SOURCE_CHARS=12000

# Docker only: host port for the web UI (docker-compose.yml).
APP_PORT=8000

# Any secret above can instead come from a file, e.g. GROQ_API_KEY_FILE=/run/secrets/groq_api_key
# (Docker/compose secrets, Kubernetes). The file is read when NAME itself is not set.
